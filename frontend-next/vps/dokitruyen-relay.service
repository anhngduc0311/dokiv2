[Unit]
Description=DokiTruyen read-only source relay
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
EnvironmentFile=/etc/dokitruyen-relay.env
ExecStart=/usr/bin/python3 /opt/dokitruyen-relay/relay.py
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
MemoryMax=192M
TasksMax=40
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
